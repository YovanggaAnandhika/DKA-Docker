/var/lib/postgresql/data/*.err {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 640 postgres postgres
    copytruncate
    compresscmd /bin/tar
    compressext .tar.gz
    compressoptions -czf
}

/var/log/postgresql/*.log {
    hourly
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 640 postgres postgres
    copytruncate
    compresscmd /bin/tar
    compressext .tar.gz
    compressoptions -czf
}

